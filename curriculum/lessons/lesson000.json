        {
          "text": "Which dot is blue",
          "correct": false,
          "misconception": "object_instead_of_relationship"
        },
        {
          "text": "How many dots there are",
          "correct": true,
          "feedback": "Yes. Four is how many dots you counted."
        },
        {
          "text": "How many pairs there are",
          "correct": false,
          "misconception": "object_instead_of_relationship"
        }
      ],
      "hints": [
