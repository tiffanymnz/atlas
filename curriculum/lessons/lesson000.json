        "revealGap": false,
        "topLabel": "Blue dots",
        "bottomLabel": "Red dots",
        "ariaLabel": "Three outlines, each holding a blue and a red dot.",
        "message": "One blue and one red make a pair."
      },
      "nextLabel": "Try pairing"
    },
