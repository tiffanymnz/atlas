  },
  "learning": {
    "learning_goal": "Count objects to ten and match one item from each group.",
    "big_idea": "The last number says how many; a pair has one from each group.",
    "assumed_prior_knowledge": []
  },
  "concepts": {
    "primary_concept": "counting_and_matching",
    "supporting_concepts": [
      "counting",
      "one_to_one_matching"
    ]
  },
  "screens": [
    {
      "id": "intro",
      "type": "intro",
      "label": "Start here",
      "title": "Count and make pairs.",
      "body": "Count dots. Then match one blue dot with one red dot."
    },
    {
      "id": "count-model",
      "type": "observe",
      "label": "Watch",
      "title": "Count one at a time.",
      "visual": {
        "kind": "countingDots",
        "count": 4,
        "numbered": true,
        "ariaLabel": "Four dots labeled 1, 2, 3, 4.",
        "message": "Touch each dot: 1, 2, 3, 4. The last number tells how many."
      },
      "nextLabel": "Try counting"
    },
    {
      "id": "count-four",
      "type": "count",
      "title": "How many dots?",
      "visual": {
        "kind": "countingDots",
        "count": 4,
        "numbered": false,
        "ariaLabel": "Dot, dot, dot, dot.",
        "message": "Point to each dot once."
      },
      "choices": [
        {
          "text": "3",
          "correct": false,
          "feedback": "You may have missed a dot. Start at the left.",
          "misconception": "object_instead_of_relationship"
        },
        {
          "text": "4",
          "correct": true,
          "feedback": "Yes. The last number is 4, so there are 4 dots."
        },
        {
          "text": "5",
          "correct": false,
          "feedback": "You may have counted one dot twice.",
          "misconception": "object_instead_of_relationship"
        }
      ],
      "hints": [
        "Touch each dot from the left.",
        "Say one number for each dot."
      ],
      "revision": 1
    },
    {
      "id": "pair-model",
      "type": "observe",
      "title": "Make pairs.",
      "visual": {
        "kind": "comparisonButtons",
