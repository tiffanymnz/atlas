      },
      "choices": [
        {
          "text": "4",
          "correct": false,
          "feedback": "Four counts blue dots. A pair needs both colors.",
          "misconception": "object_instead_of_relationship"
        },
        {
          "text": "3",
          "correct": true,
          "feedback": "Yes. Three outlines have both colors."
        },
        {
          "text": "1",
          "correct": false,
          "feedback": "One blue has no partner. Count the outlined pairs.",
          "misconception": "object_instead_of_relationship"
        }
      ],
      "hints": [
        "A pair has one of each color.",
        "Count outlines with both colors."
      ],
      "revision": 1
    },
    {
